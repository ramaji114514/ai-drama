# 复制成 .env 后按需改。**这个文件会被读**：`python run.py` 启动时会加载
# 仓库根目录的 .env（装了 python-dotenv 就用它，没装就用手写的解析器，
# 所以 .env 不是必须依赖）。也可以照旧在 shell 里 export / $env: 设置 ——
# 真实环境变量的优先级高于 .env（手写解析走 setdefault，不覆盖已有值）。
#
# 全部留空或设为 dryrun 时，整条流水线零成本跑通（本地假渲染）。

# ———— 八个 provider 的选择开关：填 provider 名，不是填 URL ————
AI_DRAMA_TEXT=dryrun
AI_DRAMA_IMAGE=dryrun
AI_DRAMA_VIDEO=dryrun
AI_DRAMA_AUDIO=dryrun
# 定妆照用的纯文生图。默认也是 dryrun —— 参考图是角色一致性的地基，
# 悄悄跳过它会让"参考锁定"整段失效，而报告里一切正常。
# 真要关掉（比如只跑分镜不想要定妆照）写 none。
AI_DRAMA_T2I=dryrun
# 口型同步。默认也是 dryrun（只做无音轨重编码，**不改嘴型**）。
# 要真的对嘴就填 dashscope（VideoRetalk，见文件末尾那一节）。
# 关掉它写 none：流水线照跑，但成片里嘴型不会对齐 ——
# 这件事会出现在 lipsync 阶段的报告里，不会静默过去。
# 要让"没同步"变成硬门槛，把 config/qc_rules.yaml 的 require_lipsync 打开。
AI_DRAMA_LIPSYNC=dryrun

# 视觉校验（"看一眼已经做出来的画面"）。
#
# [!] 这一条**和上面六个不一样：它默认是关的**，上面那一行只是"打开之后
# 用哪个"的示例。原因是一个"假装看过了"的默认检查器比没有检查器更糟 ——
# 它会把"没查成"洗成"通过了"。写 dryrun 也不行：dryrun-vision 会直接抛错，
# 结果是「没查成」，不会给你一个漂亮的 9 分。
#
# 它支撑质检里的两项（都默认关，见 config/qc_rules.yaml）：
#   require_no_text   画面里有没有字（模型很爱在招牌上写错别字）
#   require_identity  人像不像定妆照
# 没配这个变量时，那两项即使打开也只会记成「没查成」，严格模式下不放行。
# AI_DRAMA_VISION=qwen-vl-max

# 音效（环境声与动作声：雨声、门被撞开、玻璃碎）。
#
# 和上面那个一样**默认关**，理由不同：音效是加分项，而它的用量是
# **每镜 0-3 条** —— 一集 60 个镜头可能有 40 次调用，而 BGM 永远只有 1 次。
# 默认打开会让已经跑得好好的项目突然多出几十次调用、成本表被搅乱。
#
# 打开之后分镜阶段写的 `sfx` 字段才会真的被合成。
# 注意"音效"和"音乐"是两回事：BGM 走 AI_DRAMA_AUDIO，全片一条。
# AI_DRAMA_SFX=elevenlabs-sfx

# ———— 字幕 ————
# 字幕默认**烧进画面**（竖屏短剧大量是静音刷的，没有字幕等于没台词）。
# 写 0 关掉烧录 —— 注意这不等于没有字幕：subtitles.srt 照样写出来，
# 那正是多数平台要的东西。命令行上等价于 --no-subtitles。
AI_DRAMA_SUBTITLES=1
# 烧字幕用哪个字体。写**字体名**（libass 按名字找系统字体），不是文件路径。
# 留空则按平台挑一个常见 CJK 字体（Windows 是 Microsoft YaHei）。
# 中文片千万别用默认 sans —— libass 找不到能画汉字的字体时不是报错，
# 而是画出一排方块。
# AI_DRAMA_SUBTITLE_FONT=Microsoft YaHei

# ———— 音色 ————
# 一集里每个角色的嗓子由 `projects/<id>/project.json` 的 voice_map 决定。
# 不用手填：生成角色时会按 desc / anchor_prompt 里的"男/女""中老年/苍老"
# 这些线索自动定一个，并把理由写进 voice_notes
# （`python run.py project show <id> -v` 能看到"凭什么"）。
# 手动改过的音色不会被自动推断覆盖。
# 这一行只是说明，**没有对应的环境变量**：兜底音色由命令行的 --voice 决定
# （默认 female_01），只用在"脚本里没写说话人"或"描述里读不出性别"的时候。
# 想让它不是女声，就在 run 时写 --voice male_01。

# ———— 预算与并发 ————
# 美元上限，超了**抛异常停止**（绝不静默降级）。0 = 不限。
AI_DRAMA_BUDGET=0
AI_DRAMA_CONCURRENCY=3

# ———— 只产提示词时唯一要配的一家：DeepSeek ————
# 项目现在只调一家模型：写剧本/分镜的那个。配这两行就够：
#   AI_DRAMA_DEEPSEEK_API_KEY=sk-xxx
#   AI_DRAMA_TEXT=deepseek
# 可选（括号里是默认值）：
# AI_DRAMA_DEEPSEEK_MODEL=deepseek-chat        （deepseek-reasoner 更稳但更慢更贵）
# AI_DRAMA_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_DRAMA_DEEPSEEK_PRICE_IN=0.00027           # 美元/千输入 token（未命中缓存）
# AI_DRAMA_DEEPSEEK_PRICE_CACHE=0.00007        # 美元/千输入 token（命中缓存）
# AI_DRAMA_DEEPSEEK_PRICE_OUT=0.0011           # 美元/千输出 token
#
# 其余形态（T2I/IMAGE/VIDEO/AUDIO）不配就一直是 dryrun：
# 不会因为配了 text 就顺手去调别家。
#
# ———— 接其它厂商时的命名约定 ————
# AI_DRAMA_<PROVIDER>_API_KEY / AI_DRAMA_<PROVIDER>_BASE_URL
# 例：
# AI_DRAMA_MINIMAX_API_KEY=xxx
# AI_DRAMA_MINIMAX_BASE_URL=https://api.minimax.chat
#
# 注意：这里**故意不写任何厂商凭据**。接哪家是你的选择，
# providers/_template.py 里照着字段填就行。

# ———— 也能出片的一家（现在用不上）：阿里云百炼（DashScope）————
# 一个名字覆盖七种形态，只用 stdlib。这套链路现在只用来证明骨架接得住真厂商；
# 想做提示词的话上面那两行就够了。要真出画面就往下面这几行里填 dashscope，
# 并且把这个 key 填上（缺 key 会在建 provider 的那一刻就报错，不会静默降级）：
# AI_DRAMA_DASHSCOPE_API_KEY=sk-...
#
# 下面这些按需覆盖，都有合理默认值：
# AI_DRAMA_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# AI_DRAMA_DASHSCOPE_TEXT_MODEL=qwen-plus            # 剧本
# AI_DRAMA_DASHSCOPE_VISION_MODEL=qwen3-vl-plus      # 画面校验
# AI_DRAMA_DASHSCOPE_T2I_MODEL=wanx2.1-t2i-turbo     # 定妆照（文生图）
# AI_DRAMA_DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo   # 关键帧、没有定妆照时
# AI_DRAMA_DASHSCOPE_IMAGEEDIT_MODEL=wanx2.1-imageedit  # 关键帧、有定妆照时
# AI_DRAMA_DASHSCOPE_VIDEO_MODEL=wanx2.1-i2v-turbo   # 片段（图生视频）
# AI_DRAMA_DASHSCOPE_VIDEO_RESOLUTION=480P           # 480P / 720P
# AI_DRAMA_DASHSCOPE_TTS_MODEL=qwen3-tts-flash       # 配音
# AI_DRAMA_DASHSCOPE_LIPSYNC_MODEL=videoretalk       # 口型同步（VideoRetalk）
#
# 单价按**元**写（照官方价目表抄），出门前按汇率折成美元记账。
# 定价会变，代码里那份是 2026-10 华北2北京的官方价：
# AI_DRAMA_DASHSCOPE_USD_RATE=7.3
# AI_DRAMA_DASHSCOPE_PRICE_PNG=0.14              # 元/张（文生图与图生图同价）
# AI_DRAMA_DASHSCOPE_PRICE_I2V_SEC=0.24          # 元/秒，480P 标准档
# AI_DRAMA_DASHSCOPE_PRICE_TTS_CHAR=0.00008      # 元/字（= 0.8 元/万字符）
# AI_DRAMA_DASHSCOPE_PRICE_TEXT_IN=0.0008        # 元/千输入 token
# AI_DRAMA_DASHSCOPE_PRICE_TEXT_OUT=0.002
# AI_DRAMA_DASHSCOPE_PRICE_VISION_IN=0.0008
# AI_DRAMA_DASHSCOPE_PRICE_VISION_OUT=0.002
#
# 口型同步（VideoRetalk）是**唯一按美元标价**的那一个：$0.011469/秒，
# 按产出的秒数算。所以它走的是另一个变量名（注意是 PRICE_USD_）：
# AI_DRAMA_DASHSCOPE_PRICE_USD_LIPSYNC=0.011469
#
# 图生图会把定妆照当底图，也就把定妆照的**构图**一起继承过来 ——
# 实跑一集见过：分镜写了 medium 和 close，两张关键帧几乎一样。
# 要景别听分镜的就关掉它（代价是每镜的脸都会重新长）：
# AI_DRAMA_DASHSCOPE_IMAGE_USE_PORTRAIT=0
#
# 口型同步还有两件实跑才知道的事，先说在这儿省得你以为是坏了：
# * 竖屏 480P 是 464x832，短边 464 **不够**接口要求的 640 —— 会自动放大
#   上传、产物再缩回原尺寸（usage 的 note 里写着）。
# * VideoRetalk 会重新整片编码一次，**色调会变冷一点**。同一件衣服、
#   同一个人，同步前后看着像换了个滤镜。这是它自己的编码，不是出错了。

# ———————————————————————————————————————————————— 片长：默认 15 秒
#
# 一个镜头默认拍 15 秒（core/media.default_shot_seconds）。它抬的是**下限**：
# 台词比 15 秒还长时，镜头仍然跟着台词走，不会被剪断。
#
# 15 秒是创作决定，不是模型能力。模型一次能出多久由 config/models.yaml 的
# max_duration 声明；要的比那长就被拆成多段再拼（plan_shot_split），
# **不会静默截断**。
AI_DRAMA_SHOT_SECONDS=15

# ———————————————————————————————————————————————— 另一家：aihubmix（Seedance）
#
# 接它的理由只有一个：**单段时长**。百炼的 wanx 系列一次最多 5 秒，
# 一个 15 秒的镜头会被拆成 3 段，而 3 段是各自从同一张关键帧起跑的，
# 拼起来画面会跳回去。Seedance 一次能出 30 秒，所以 15 秒是**一条**连续片子。
#
# 用法（只换视频这一种形态，其它照旧）：
#   AI_DRAMA_AIHUBMIX_API_KEY=sk-...
#   AI_DRAMA_VIDEO=aihubmix
#
# [!] 首次使用必须先去 https://console.aihubmix.com/async-tasks 把
#     **异步任务**打开。不开的话提交会 403，错误码是 async_not_enabled，
#     而它长得像"key 不对"—— 这个坑记在这里。
#
# AI_DRAMA_AIHUBMIX_API_KEY=
# AI_DRAMA_AIHUBMIX_VIDEO_MODEL=doubao-seedance-2-5-260628
#
# 这个服务按 video token 计费，没有公开的每秒单价。所以**不填**下面这个
# 变量时，成本表里这一项记 0 并注明"未配每秒单价"，而不是编一个数让
# 预算闸门失准。等你从账单上算出来真实单价再填：
# AI_DRAMA_AIHUBMIX_USD_PER_SECOND=
#
# 它默认会生成音轨，适配器里已经显式关掉了 —— 台词和 BGM 由拼接阶段
# 统一铺一次，不关就是两层声音叠在一起。
